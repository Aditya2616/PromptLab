# Backend: "local" (transformers, default; CUDA float16 when a GPU is available, else CPU float32), "openai" (any OpenAI-compatible server) or "fake" (scripted, tests/demo)
PROMPTLAB_BACKEND=local
PROMPTLAB_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# CPU threads for the local backend (default: a quarter of the logical cores)
PROMPTLAB_THREADS=3
# Only for PROMPTLAB_BACKEND=openai. Point OPENAI_BASE_URL at a local server (llama.cpp, vLLM, Ollama) to stay offline.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
